# Cloudinary credentials for scripts/upload-frames-cloudinary.mjs only.
# Copy to .env.local and fill in. Never commit .env.local.
CLOUDINARY_CLOUD_NAME=dghhdz3et
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client-side delivery. The cloud name is public; it appears in every frame URL.
# Optional: HeroSequence falls back to dghhdz3et when unset.
VITE_CLOUDINARY_CLOUD_NAME=dghhdz3et
